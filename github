git fetch origin --prune
OD="2026-08-25"

for B in $(git for-each-ref --format='%(refname:short)|%(committerdate:short)' refs/remotes/origin/ \
           | grep -Ev '^origin/(HEAD|master|DEV|TST|ACC)\|' \
           | awk -F'|' -v a="$OD" '$2>=a {print $1}'); do
  ZRODLA=""
  for E in DEV TST ACC; do
    for C in $(git rev-list --first-parent --since="$OD" "origin/master..origin/$E"); do
      if git merge-base --is-ancestor "$C" "$B"; then
        ZRODLA="$ZRODLA $E"
        break
      fi
    done
  done
  [ -z "$ZRODLA" ] && echo "OK   $B" || echo "FAIL $B (stoi na:$ZRODLA)"
done
