#!/bin/bash
# Kandydaci do wdrożenia: gałęzie z commitami ponad master, sortowane malejąco

git fetch origin --prune

git for-each-ref --format='%(refname:short)' refs/remotes/origin/ \
| grep -Ev '^origin/(HEAD|master|DEV|TST|ACC)$' \
| while read -r B; do
    N=$(git rev-list --count "origin/master..$B")
    [ "$N" -eq 0 ] && continue
    BASE=$(git merge-base origin/master "$B")
    printf "%4d  %s  %s  %s\n" \
      "$N" \
      "$(git log -1 --format=%cs "$B")" \
      "$(git log -1 --format=%cs "$BASE")" \
      "$B"
  done \
| sort -rn

